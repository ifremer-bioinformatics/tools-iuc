<tool name="qiime2 dbOTU" id="qiime2__dbotu" version="2024.10.0+q2galaxy.2024.10.0" profile="22.05" license="BSD-3-Clause">
    <description></description>
    <xrefs>
        <xref type="bio.tools">qiime2</xref>
    </xrefs>
    <requirements>
        <container type="docker">sebimer/samba-v4-qiime2:2024.2</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
        mkdir ./output_dir &&
        mkdir ./input_dir &&
        cp '$table' './input_dir/${table.element_identifier}' &&
        cp '$sequence' './input_dir/${sequence.element_identifier}' &&
        qiime dbotu-q2 call-otus --i-table './input_dir/${table.element_identifier}' --i-sequences './input_dir/${sequence.element_identifier}' --o-dbotu-table './output_dir/output_table.qza' --o-representative-sequences './output_dir/output_sequence.qza'
    ]]></command>
    <inputs>
        <param name="table" type="data" format="qza" label="table" help=""/>
        <param name="sequence" type="data" format="qza" label="sequence" help=""/>
    </inputs>
    <outputs>
        <data name="visualization" format="qza" label="${tool.name} on ${on_string}: qza" from_work_dir="./output_dir/*.qza"/>
    </outputs>
    <tests>
        <test>
            <param name="table" value=".qza" ftype="qza"/>
            <output name="visualization" ftype="qzv">
                <assert_contents>
                    <has_archive_member path="[0-9a-f]{8}-[0-9a-f]{4}-[4][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\/metadata.yaml">
                        <has_line_matching expression="type: Visualization"/>
                    </has_archive_member>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help>
